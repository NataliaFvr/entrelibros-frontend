# Copiá este archivo como `.env` (el `.env` real no se sube a git) y reiniciá `npm run dev`.

# true  -> la app usa el back real (Spring Boot).
# false -> modo demostración: datos de ejemplo guardados en este navegador (mocks), sin red.
VITE_API=true

# Raíz del servidor del back (con o sin el sufijo /api/v1: el front lo normaliza).
VITE_API_URL=http://localhost:8080
